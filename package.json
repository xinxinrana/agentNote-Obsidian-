{
  "name": "agentnote-obsidian",
  "version": "0.4.9",
  "description": "agentNote: a local note and file relay for AI agents, as an Obsidian plugin",
  "author": "Evan",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "npm run typecheck && npm run build && node test/e2e.mjs",
    "test:git-sync": "npm run build && node test/git-sync.mjs",
    "typecheck": "tsc --noEmit",
    "deploy:test": "npm run build && node scripts/deploy-test.mjs",
    "preview:pet": "node scripts/build-pet-preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "yaml": "^2.9.0"
  }
}
